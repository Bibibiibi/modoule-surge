#!name=Claude Panel
#!desc=Claude 可用地區檢測 Panel（不顯示 WARP 狀態）
#!author=Bibibiibi

# 可在 argument 中自訂 title、icon、iconerr、icon-color、iconerr-color。

[Panel]
Claude = title="Claude",content="區域可用性檢測",script-name=Claude_Availability,update-interval=-1

[Script]
Claude_Availability = type=generic,timeout=8,script-path=https://raw.githubusercontent.com/Bibibiibi/modoule-surge/main/Claude_2_nowarp.js,script-update-interval=86400,argument=title=Claude&icon=brain.head.profile&iconerr=xmark.seal.fill&icon-color=#D97706&iconerr-color=#D65C51
